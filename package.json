{
  "name": "@mshick/fast-envsubst",
  "version": "1.0.2",
  "description": "A GitHub Action which mimics envsubst.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc --noEmit && ncc build fast-envsubst.ts -o dist -m",
    "lint": "eslint .",
    "test": "tsc --noEmit && jest",
    "clean": "rm -rf node_modules dist __tests__/runner/*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mshick/fast-envsubst.git"
  },
  "keywords": [
    "GitHub",
    "Actions",
    "javascript",
    "typescript",
    "config files",
    "env",
    "envsubst"
  ],
  "author": "Michael Shick <m@shick.us>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/mshick/fast-envsubst/issues"
  },
  "homepage": "https://github.com/mshick/fast-envsubst#readme",
  "dependencies": {
    "@actions/core": "^2.0.3",
    "dotenv": "^18.0.9"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@vercel/ncc": "^0.38.0",
    "eslint": "^10.14.0",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1"
  },
  "engines": {
    "node": ">=24"
  }
}
